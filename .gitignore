# Ignore local secrets and sensitive files
.bash_secrets
.env
*.key
*.secret
*.token

# Ignore stow backup/ignore files
.stow-local-ignore
*~
*.swp

# Ignore the setup script's temporary artifacts
*.log

# Ignore Polaris/agent session + council artifacts
.polaris/

# Ignore Python bytecode cache next to stowed scripts
__pycache__/