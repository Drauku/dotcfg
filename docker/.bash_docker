#!/bin/bash
# --- containers/.bash_ct_cmd ---

# Container stacks/projects directory
stacks_dir='/srv/stacks'

# Check if Container Stack Manager (CSM) is already handled
csm_dir="$HOME/git/container-stack-manager"

# Detect if we should use Podman (common on Fedora/CoreOS)
if command -v podman >/dev/null 2>&1; then
    alias docker='podman'
    export ct_engine='podman'
elif command -v docker >/dev/null 2>&1; then
    export ct_engine='docker'
fi

# Safely run docker commands with or without sudo
if id -Gn | grep -qw $ct_engine; then
    ct_cmd(){ $ct_engine "$@"; }
else
    ct_cmd(){ run_cmd $ct_engine "$@"; }
fi

# Check if docker user and group exists before exporting
if getent passwd $ct_engine >/dev/null 2>&1 && getent group $ct_engine >/dev/null 2>&1; then
    export dk_uid="$(id -u $ct_engine 2>/dev/null)"
    export dk_gid="$(id -g $ct_engine 2>/dev/null)"
else
    echo "${ylw}Warning${rst}: '$ct_engine' user/group not found — stack creation may fail."
fi

# Safely run commands as root or non-root user
if command -v sudo >/dev/null 2>&1; then
    if [[ $EUID -ne 0 ]]; then
        run_cmd(){ sudo "$@"; }
    else
        run_cmd(){ "$@"; }
    fi
else
    run_cmd(){ "$@"; }
fi

# Validate stacks_dir exists, prompt to create if not
if [ ! -d "$stacks_dir" ]; then
    echo "${ylw}Warning${rst}: Stacks directory '${cyn}${stacks_dir}${rst}' not found."
    printf "Create it now? [y/N] "
    read -r reply
    if [[ "$reply" =~ ^[Yy]$ ]]; then
        run_cmd mkdir -p "$stacks_dir" || { echo "${red}Error${rst}: Failed to create '$stacks_dir'"; return 1; }
    else
        echo "${red}Skipping $ct_engine alias setup — stacks directory missing.${rst}"
        return 0
    fi
fi

# Create ~/stacks symlink if it doesn't already exist
if [ ! -e "$HOME/stacks" ]; then
    ln -s "$stacks_dir" "$HOME/stacks"
fi

# Check host and container IPs
hostip()  { echo "Host IP: $(wget -qO- ifconfig.me)"; }
lancheck(){ echo "Container IP: $(ct_cmd container exec -it "${*}" wget -qO- ipinfo.io)"; }
vpncheck(){ echo "Container IP: $(ct_cmd container exec -it "${*}" wget -qO- ipinfo.io/ip)" && \
            echo "     Host IP: $(wget -qO- ifconfig.me)"; }

# Docker shortcuts
alias stacks='cd $stacks_dir'

# Load CSM or legacy aliases
if [ -d "$csm_dir" ] && command -v csm >/dev/null 2>&1; then
    cdcsm(){cd "$csm_dir" "$@"; }
else

    ct_start(){ ct_cmd compose -f "$stacks_dir/${1}/compose.yml" up -d --remove-orphans; }
    ct_stop() { ct_cmd compose -f "$stacks_dir/${1}/compose.yml" down; }
    ctu(){ ct_start "$@"; }
    ctd(){ ct_stop "$@"; }

    ct_bounce(){ ct_stop "$1" && ct_start "$1"; }
    ctb(){ ct_bounce "$@"; }

    ct_logs(){ ct_cmd compose -f "$stacks_dir/${1}/compose.yml" logs -f --tail=50; }
    ctg(){ ct_logs "$@"; }

    ct_new_stack(){
        if [ "$#" -ne 2 ]; then echo "${red}Error${ylw}: Missing stack name${rst}"; return 1; fi
        local scope="$1"
        local stack="$2"
        if [ "$scope" = "stack" ]; then scope=""; fi
        local stack_path="${stacks_dir}${scope:+/$scope}/$stack"
        local env_file="$stacks_dir/.common/.docker.env"
        local env_link="$stack_path/.env"
        if [ -z "$dk_uid" ] || [ -z "$dk_gid" ]; then
            echo "${red}Error${rst}: $ct_engine user/group not defined — cannot create stack"; return 1
        fi
        if [[ $EUID -ne 0 ]]; then
            echo "${ylw}Creating stack requires elevated privileges.${rst}"
            sudo -v || { echo "${red}Error${ylw}: sudo authentication failed${rst}"; return 1; }
        fi
        run_cmd install -o "$dk_uid" -g "$dk_gid" -m 774 -d "$stack_path"
        run_cmd install -o "$dk_uid" -g "$dk_gid" -m 660 /dev/null "$stack_path/compose.yml"
        if [ ! -e "$env_link" ]; then
            if [ -f "$env_file" ]; then
                ln -sf "$env_file" "$env_link"
            else
                run_cmd install -o "$dk_uid" -g "$dk_gid" -m 660 /dev/null "$env_link"
            fi
        fi
        echo "${grn}Created stack files in ${cyn}${stack_path}${rst}"
    }
    ctns(){ ct_new_stack "stack" "$@"; }
    ctn(){ ct_new_stack "stack" "$@"; }

    ct_dir(){
        if [ "$#" -ne 2 ]; then echo "${red}Error${ylw}: Missing stack name${rst}"; return 1; fi
        local scope="$1"
        local stack="$2"
        if [ "$scope" = "stack" ]; then scope=""; fi
        local target="${stacks_dir}${scope:+/$scope}/$stack"
        [ -d "$target" ] || { echo "${red}Error${ylw}: Stack '${cyn}$target${ylw}' not found${rst}"; return 1; }
        cd "$target"
    }
    ctcd(){ ct_dir "stack" "$@"; }

    ct_list_networks(){
        printf "%sNETWORK ID\tDRIVER\tSCOPE\tNAME%s\n" "$bld" "$rst"
        ct_cmd network ls --format "{{.ID}}\t{{.Driver}}\t{{.Scope}}\t{{.Name}}"
    }
    ctln(){ ct_list_networks "$@"; }

    ct_list_containers() {
        { printf "CONTAINER ID\tNAME\tSTATUS\tPORTS\n"
            # 2. Get data, sort, and clean Ports via awk (plain text only)
            # Strip 0.0.0.0: and IPv6 [::]: prefixes, then remove container port mappings
            ct_cmd ps --format "{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}" | \
            sort -k2,2 | \
            awk 'BEGIN { FS="\t"; OFS="\t" } {
                gsub(/0\.0\.0\.0:/, "", $4)
                gsub(/, *\[::\]:[^ ]*/, "", $4)
                gsub(/->[0-9]+/, "", $4)
                print $1, $2, $3, $4
            }'
        } | column -ts $'\t' | sed -E "
            1 s/^.*$/$bld&$rst/
            2,\$ s/^([^ ]+ +)([^ ]+)/\1$cyn\2$rst/
            s/unhealthy/$red&$rst/g
            s/\bhealthy\b/$grn&$rst/g
            s/([0-9]+\/[a-z]+)/$blu\1$rst/g
        "
    }
    ctl(){ ct_list_containers "$@"; }
    ctlc(){ ct_list_containers "$@"; }

fi
