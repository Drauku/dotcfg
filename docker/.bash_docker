#!/bin/bash
# --- containers/.bash_ct_cmd ---

# Container stacks/projects directory
stacks_dir="$HOME/stacks"
backup_dir="$stacks_dir/.backup"
common_dir="$stacks_dir/.common"

# Check if Container Stack Manager (CSM) is already handled
csm_script="$HOME/stacks/.common/csm.sh"

# Detect if we should use Podman (common on Fedora/CoreOS)
if command -v podman >/dev/null 2>&1; then
    alias docker='podman'
    export ct_engine='podman'
elif command -v docker >/dev/null 2>&1; then
    export ct_engine='docker'
else
    echo "${red}Error${rst}: Neither Podman nor Docker is installed."
    return 1
fi

# Safely run container commands with or without sudo
if id -Gn | grep -qw $ct_engine; then
    ct_cmd(){ $ct_engine "$@" || echo "${red}Error: Command '$ct_engine ${*}' failed.${rst}"; }
else
    ct_cmd(){ run_cmd $ct_engine "$@" || echo "${red}Error: Command 'sudo $ct_engine ${*}' failed.${rst}"; }
fi

# Set the user and group for stacks
ct_usr="$USER"
ct_grp="docker"

# Get UID and GID for the stacks user, with a default of 2000
if id -u "$ct_usr" >/dev/null 2>&1; then
    export ct_uid="$(id -u "$ct_usr")"
else
    export ct_uid="2000"
fi

if id -g "$ct_grp" >/dev/null 2>&1; then
    export ct_gid="$(id -g "$ct_grp")"
else
    export ct_gid="2000"
fi

# Check if container user and group exists before exporting
if ! getent passwd "$ct_usr" >/dev/null 2>&1 || ! getent group "$ct_grp" >/dev/null 2>&1; then
    echo "${ylw}Warning${rst}: '$ct_usr' user/group not found. Defaulting to User '$ct_urs', Group '$ct_grp', and UID:GID ${ct_uid}:${ct_gid}."
fi

# Safely run commands as root or non-root user
if command -v sudo >/dev/null 2>&1; then
    if [[ $EUID -ne 0 ]]; then
        run_cmd(){ sudo "$@" || echo "${red}Error: Command failed with sudo.${rst}"; }
    else
        run_cmd(){ "$@" || echo "${red}Error: Command failed.${rst}"; }
    fi
else
    run_cmd(){ "$@" || echo "${red}Error: Command failed.${rst}"; }
fi

# Validate stacks_dir exists, prompt to create if not
if [ ! -d "$stacks_dir" ]; then
    echo "${ylw}Warning${rst}: Stacks directory '${cyn}${stacks_dir}${rst}' not found."
    printf "Create it now? [y/N] "
    read -r reply
    if [[ "$reply" =~ ^[Yy]$ ]]; then
        run_cmd mkdir -p "$stacks_dir" || { echo "${red}Error${rst}: Failed to create '$stacks_dir'"; return 1; }
    else
        echo "${red}Skipping $ct_engine alias setup — stacks directory missing.${rst}"
        return 0
    fi
fi

# Create ~/stacks symlink if it doesn't already exist
if [ ! -e "$HOME/stacks" ]; then
    ln -s "$stacks_dir" "$HOME/stacks"
fi

# Check host and container IPs
iphost(){ echo "Host IP: $(wget -qO- https://ifconfig.me/ip)"; }; alias myip="hostip"
iplan() { echo "Container IP: $(ct_cmd container exec -it "${*}" wget -qO- https://ipinfo.io)"; }
ipvpn() { echo "Container IP: $(ct_cmd container exec -it "${*}" wget -qO- https://ipinfo.io/ip)" && \
          echo "     Host IP: $(wget -qO- https://ifconfig.me)"; }
wtup() {
    [[ -z \$1 ]] || echo "Usage: ctupdate <container-name>"; return 0
    $csm_cmd run --rm --name "\$1-update" -v /var/run/$csm_cmd.sock:/var/run/$csm_cmd.sock ghcr.io/nicholas-fedor/watchtower --run-once "\$1";
}

# Load CSM or legacy aliases
if command -v csm >/dev/null 2>&1; then
    # cd into stacks directory or a specific stack
    if alias cds >/dev/null 2>&1; then unalias cds; fi
    # (( $+aliases[cds] )) && unalias cds # zfs compatible only
    eval "$(csm --aliases)"
    return
else

    ct_start(){ ct_cmd compose -f "$stacks_dir/${1}/compose.yml" up -d --remove-orphans || echo "${red}Error: Failed to start stack '${1}'.${rst}"; }
    ctu(){ ct_start "$@"; }

    ct_stop() { ct_cmd compose -f "$stacks_dir/${1}/compose.yml" down || echo "${red}Error: Failed to stop stack '${1}'.${rst}"; }
    ctd(){ ct_stop "$@"; }

    ct_bounce(){ ct_stop "$1" && ct_start "$1" || echo "${red}Error: Failed to bounce stack '$1'.${rst}"; }
    ctb(){ ct_bounce "$@"; }

    ct_logs(){ ct_cmd compose -f "$stacks_dir/${1}/compose.yml" logs -f --tail=50 || echo "${red}Error: Failed to get logs for stack '${1}'.${rst}"; }
    ctg(){ ct_logs "$@"; }

    ct_stack_backup() {
        local stack_name="${1:-}"
        [[ -z "$stack_name" ]] && { log FAIL "Stack name required"; return 1; }

        local stack_dir="$(get_stack_dir "$stack_name")"
        [[ ! -d "$stack_dir" ]] && { log FAIL "Stack '$stack_name' does not exist."; return 1; }

        local ts
        ts="$(date +%Y%m%d_%H%M%S)"
        local target_backup_dir="${backup_dir}/${stack_name}"
        local backup_file="${target_backup_dir}/${stack_name}_${ts}.tar.gz"

        mkdir -p "$target_backup_dir"
        log INFO "Creating backup: $backup_file"
        tar -czf "$backup_file" -C "$csm_stacks" "$stack_name"
        log DONE "Backup complete."
    }
    ctbu(){ ct_stack_backup "$@"; }

    ct_new_stack(){
        if [ "$#" -ne 2 ]; then
            echo "${red}Error:${ylw} Missing stack name.${rst}"
            return 1
        fi
        local scope="$1"
        local stack="$2"
        if [ "$scope" = "stack" ]; then
            scope=""
        fi
        local stack_path="${stacks_dir}${scope:+/$scope}/$stack"
        local env_file="$common_dir/.container.env"
        local env_link="$stack_path/.env"
        if [ -z "$ct_uid" ] || [ -z "$ct_gid" ]; then
            echo "${red}Error${rst}: $ct_engine user/group not defined — cannot create stack."; return 1
        fi
        if [[ $EUID -ne 0 ]]; then
            echo "${ylw}Creating stack requires elevated privileges.${rst}"
            sudo -v || { echo "${red}Error:${ylw} sudo authentication failed.${rst}"; return 1; }
        fi
        run_cmd install -o "$ct_uid" -g "$ct_gid" -m 774 -d "$stack_path"
        run_cmd install -o "$ct_uid" -g "$ct_gid" -m 660 /dev/null "$stack_path/compose.yml"
        if [ ! -e "$env_link" ]; then
            if [ -f "$env_file" ]; then
                ln -sf "$env_file" "$env_link"
            else
                run_cmd install -o "$ct_uid" -g "$ct_gid" -m 660 /dev/null "$env_link"
            fi
        fi
        echo "${grn}Created stack files in ${cyn}${stack_path}${rst}"
    }
    ctns(){ ct_new_stack "stack" "$@"; }
    ctn(){ ct_new_stack "local" "$@"; }

    ct_dir(){
        local scope stack target
        scope="$1"
        stack="$2"
        [ "$#" -ne 2 ] && { echo "${red}Error:${ylw} Missing stack name.${rst}"; return 1; }
        [ "$scope" = "stack" ] && scope=""
        target="${stacks_dir}${scope:+/$scope}/$stack"
        [ -d "$target" ] || { echo "${red}Error:${ylw} Stack '${cyn}$target${ylw}' not found.${rst}"; return 1; }
        cd "$target"
    }
    cds(){ ct_dir "stack" "$@"; }

    ct_list_networks(){
        printf "%sNETWORK ID\tDRIVER\tSCOPE\tNAME%s\n" "$bld" "$rst"
        ct_cmd network ls --format "{{.ID}}\t{{.Driver}}\t{{.Scope}}\t{{.Name}}" || echo "${red}Error: Failed to list networks.${rst}"
    }
    ctln(){ ct_list_networks "$@"; }

    ct_list_containers() {
        { printf "CONTAINER ID\tNAME\tSTATUS\tPORTS\n"
            # 2. Get data, sort, and clean Ports via awk (plain text only)
            # Strip 0.0.0.0: and IPv6 [::]: prefixes, then remove container port mappings
            ct_cmd ps --format "{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}" | \
            sort -k2,2 | \
            awk 'BEGIN { FS="\t"; OFS="\t" } {
                gsub(/0\.0\.0\.0:/, "", $4)
                gsub(/, *\[::\]:[^ ]*/, "", $4)
                gsub(/->[0-9]+/, "", $4)
                print $1, $2, $3, $4
            }'
        } | column -ts $'\t' | sed -E "
            1 s/^.*$/$bld&$rst/
            2,\$ s/^([^ ]+ +)([^ ]+)/\1$cyn\2$rst/
            s/unhealthy/$red&$rst/g
            s/\bhealthy\b/$grn&$rst/g
            s/([0-9]+\/[a-z]+)/$blu\1$rst/g
        " || echo "${red}Error: Failed to list containers.${rst}"
    }
    ctl(){ ct_list_containers "$@"; }
    ctlc(){ ct_list_containers "$@"; }

fi
