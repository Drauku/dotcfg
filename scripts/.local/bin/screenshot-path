#!/usr/bin/env bash
# screenshot-path — take an interactive screenshot and copy the saved file's
# PATH (shell-quoted text) to the clipboard, instead of the image data.
#
# Why: terminals reject image pastes. This lets you screenshot, then
# Ctrl+Shift+V the path straight into a terminal (e.g. for an AI CLI that
# reads image files by path).
#
# How it works:
#   Calls the freedesktop Screenshot portal (org.freedesktop.portal.Screenshot)
#   over D-Bus with interactive=true. Your desktop's native screenshot UI
#   opens (GNOME Shell UI on GNOME, Spectacle on KDE). After capture, the
#   portal returns the saved file's URI; the path is shell-quoted and copied
#   to the clipboard. Cancelling exits quietly with status 1.
#
#   The portal answers with a Response signal on an object path derived from
#   the calling connection's unique bus name. `gdbus call` and `gdbus monitor`
#   are separate connections, so the monitor watches every Request signal from
#   the portal and the reply is matched against the handle the call returns.
#
# Works on any desktop with an xdg-desktop-portal Screenshot backend:
#   GNOME (xdg-desktop-portal-gnome), KDE (xdg-desktop-portal-kde),
#   wlroots compositors (xdg-desktop-portal-wlr), etc.
#
# Dependencies:
#   - gdbus [glib2] — the library xdg-desktop-portal itself is built on
#   - flock [util-linux]
#   - clipboard tool: wl-copy on Wayland [wl-clipboard], xclip on X11
#   - optional: notify-send for a confirmation popup [libnotify]
#
# Install:
#   Stowed into ~/.local/bin by install.sh via the 'scripts' package. To link it
#   by hand: ln -s ~/.dotfiles/scripts/.local/bin/screenshot-path ~/.local/bin/
#
# Hotkey setup (suggested: Ctrl+Print):
#   GNOME — register a custom keybinding:
#     BASE=org.gnome.settings-daemon.plugins.media-keys
#     KEY=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/
#     gsettings set $BASE custom-keybindings "[..existing.., '$KEY']"
#     gsettings set $BASE.custom-keybinding:$KEY name 'Screenshot (copy path)'
#     gsettings set $BASE.custom-keybinding:$KEY command "$HOME/.local/bin/screenshot-path"
#     gsettings set $BASE.custom-keybinding:$KEY binding '<Control>Print'
#   KDE — System Settings > Keyboard > Shortcuts > Add Command, point it at
#     this script and assign a key.

set -uo pipefail

PORTAL_DEST="org.freedesktop.portal.Desktop"
PORTAL_PATH="/org/freedesktop/portal/desktop"
# Seconds to wait for the capture; the UI stays open until the user acts.
TIMEOUT="${SCREENSHOT_PATH_TIMEOUT:-300}"

die() { printf 'screenshot-path: %s\n' "$1" >&2; exit 1; }

# Percent-decode a URI path. Backslashes are escaped first so printf leaves
# them intact rather than reading them as escape sequences.
urldecode() {
    local s=${1//\\/\\\\}
    printf '%b' "${s//%/\\x}"
}

for cmd in gdbus flock; do
    command -v "$cmd" >/dev/null || die "$cmd not found"
done

# An exclusive lock held for the process lifetime; a second run exits while the
# portal dialog from the first is still open.
lock_file="${XDG_RUNTIME_DIR:-/tmp}/screenshot-path.lock"
exec 9>"$lock_file" || die "cannot open $lock_file"
flock -n 9 || exit 0

monitor_log=$(mktemp -t screenshot-path.XXXXXX) || die "cannot create temp file"
monitor_pid=""
cleanup() {
    [ -n "$monitor_pid" ] && kill "$monitor_pid" 2>/dev/null
    rm -f "$monitor_log"
}
trap cleanup EXIT

# The portal requires a handle_token unique per request; it forms the object
# path the Response signal arrives on.
if [ -r /proc/sys/kernel/random/uuid ]; then
    token="screenshotpath$(tr -d - < /proc/sys/kernel/random/uuid)"
else
    token="screenshotpath$$$RANDOM"
fi

# 9>&- keeps the lock fd out of the monitor and its children, so a stray
# descendant cannot hold the lock after this run exits.
gdbus monitor --session --dest "$PORTAL_DEST" > "$monitor_log" 2>/dev/null 9>&- &
monitor_pid=$!

# Signals emitted before the monitor connects are lost, so wait for its banner.
for _ in $(seq 1 100); do
    grep -q "Monitoring signals" "$monitor_log" && break
    sleep 0.05
done
kill -0 "$monitor_pid" 2>/dev/null || die "gdbus monitor exited"

handle=$(gdbus call --session --dest "$PORTAL_DEST" --object-path "$PORTAL_PATH" \
    --method org.freedesktop.portal.Screenshot.Screenshot \
    "" "{'handle_token': <'$token'>, 'interactive': <true>}" 2>&1) \
    || die "portal call failed: $handle"

handle=$(printf '%s' "$handle" | sed -n "s/.*objectpath '\([^']*\)'.*/\1/p")
[ -n "$handle" ] || die "portal returned no request handle"

response=""
deadline=$((SECONDS + TIMEOUT))
while [ "$SECONDS" -lt "$deadline" ]; do
    response=$(grep -F "$handle: org.freedesktop.portal.Request.Response" "$monitor_log" | head -1)
    [ -n "$response" ] && break
    kill -0 "$monitor_pid" 2>/dev/null || die "gdbus monitor exited"
    sleep 0.1
done
[ -n "$response" ] || die "timed out after ${TIMEOUT}s waiting for the portal"

code=$(printf '%s' "$response" | sed -n 's/.*(uint32 \([0-9]*\).*/\1/p')
[ "$code" = "0" ] || exit 1  # cancelled or failed

uri=$(printf '%s' "$response" | sed -n "s/.*'uri': <'\([^']*\)'>.*/\1/p")
[ -n "$uri" ] || die "portal returned no uri"

path=$(urldecode "${uri#file://}")
quoted=$(printf '%q' "$path")
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    wl-copy "$quoted" || die "wl-copy failed"
else
    printf '%s' "$quoted" | xclip -selection clipboard || die "xclip failed"
fi

notify-send -a Screenshot "Path copied" "$path" 2>/dev/null || true
